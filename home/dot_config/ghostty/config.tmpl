theme = Kanagawa Wave

font-family = TX-02
font-family-bold = TX-02
font-family-italic = TX-02 Oblique
font-family-bold-italic = TX-02 Bold Oblique
{{ if eq .chezmoi.os "darwin" -}}
font-size = 14
{{ else -}}
font-size = 11
{{ end }}
background-opacity = 0.92

window-padding-x = 9
window-padding-y = 8,0

{{ if eq .chezmoi.os "darwin" -}}
window-theme = ghostty
window-show-tab-bar = auto
window-save-state = never
macos-titlebar-style = hidden
macos-window-buttons = hidden
{{- else -}}
window-decoration = server 
window-theme = ghostty
window-show-tab-bar = auto
gtk-single-instance = false
{{- end }}

confirm-close-surface = false
focus-follows-mouse = true

{{ if eq .chezmoi.os "linux" -}}
gtk-titlebar = true
gtk-titlebar-style = native
gtk-tabs-location = top
gtk-toolbar-style = flat
gtk-wide-tabs = false
gtk-custom-css = {{ .chezmoi.homeDir }}/.config/ghostty/theme.css

{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+t=new_tab
keybind = ctrl+a>t=new_tab
{{ end -}}
keybind = ctrl+backspace=text:\x17
{{ if eq .chezmoi.os "darwin" -}}
keybind = ctrl+left=text:\x1b[1;5D
keybind = ctrl+right=text:\x1b[1;5C
{{ end -}}
keybind = ctrl+a>h=new_split:down
keybind = ctrl+a>v=new_split:right
keybind = ctrl+a>s=toggle_tab_overview
keybind = ctrl+a>x=equalize_splits
keybind = ctrl+a>w=close_surface
keybind = ctrl+a>left=goto_split:left
keybind = ctrl+a>right=goto_split:right
keybind = ctrl+a>up=goto_split:up
keybind = ctrl+a>down=goto_split:down
keybind = ctrl+a>.=resize_split:right,50
keybind = ctrl+a>,=resize_split:left,50
keybind = shift+enter=text:\x1b\x0d
