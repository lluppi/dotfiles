# kanagawa wave reading colours, on from startup, f8 toggles them off (see keys_user.config)
custom_background_color 0.122 0.122 0.157
custom_text_color 0.863 0.843 0.729
# app clear colour behind the page: light grey (sioyek default) so toggling kanagawa off gives
# a normal light reader. set back to 0.122 0.122 0.157 if you want the frame dark in both modes.
background_color 0.97 0.97 0.97
startup_commands toggle_custom_color
ui_font TX-02
