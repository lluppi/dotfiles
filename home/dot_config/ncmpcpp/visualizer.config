# second ncmpcpp in `music` (linux): just the visualizer, next to the now-playing strip.
# drome-lord forwards mpv's pcm (captured from pipewire) over udp; this instance alone binds it
mpd_host = 127.0.0.1
mpd_port = 6600
startup_screen = visualizer
header_visibility = no
statusbar_visibility = no
titles_visibility = no
progressbar_look = "   "
connected_message_on_startup = no

visualizer_data_source = localhost:5555
visualizer_output_name = visualizer
visualizer_in_stereo = yes
visualizer_type = spectrum
visualizer_spectrum_smooth_look = yes
visualizer_look = ●▮
visualizer_color = 5, 6, 14, 12
visualizer_fps = 60
visualizer_autoscale = yes

colors_enabled = yes
main_window_color = default
